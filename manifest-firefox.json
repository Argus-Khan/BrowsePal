{
  "manifest_version": 3,
  "name": "Browser Agent Bridge",
  "version": "0.2.0",
  "description": "AI-agent-optimized browser bridge. Provides page snapshots, action plans, and reactive subscriptions over local WebSocket (JSON-RPC 2.0).",
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "cookies",
    "webRequest",
    "webNavigation",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": ["<all_urls>", "ws://localhost/*", "ws://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-agent@local",
      "strict_min_version": "128.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src 'self' ws://localhost:* ws://127.0.0.1:* wss://localhost:* wss://127.0.0.1:*;"
  },
  "action": {
    "default_title": "Browser Agent Bridge",
    "default_popup": "popup.html"
  }
}
