{
  "name": "browser-agent-tools",
  "version": "0.1.0",
  "type": "module",
  "description": "Standard toolkit and example agent server for the Browser Agent Bridge extension.",
  "main": "examples/agent-tools.mjs",
  "bin": {
    "browser-agent-tools": "examples/agent-tools.mjs",
    "bab-tools": "examples/agent-tools.mjs"
  },
  "files": [
    "examples/agent-tools.mjs",
    "examples/agent-server.js",
    "examples/*.json",
    "README.md",
    "manifest.json",
    "manifest-firefox.json",
    "background.js",
    "content.js",
    "options.html",
    "options.js",
    "options.css",
    "lib/",
    "dist/"
  ],
  "scripts": {
    "start": "node examples/agent-server.js",
    "tools": "node examples/agent-tools.mjs",
    "build": "node scripts/build-dist.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "browser-automation",
    "ai-agent",
    "webextension",
    "json-rpc",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  }
}
