{
  "manifest_version": 3,
  "name": "Browser Agent Bridge",
  "version": "0.2.0",
  "description": "AI-agent-optimized browser bridge. Provides page snapshots, action plans, and reactive subscriptions over local WebSocket (JSON-RPC 2.0).",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "cookies",
    "webRequest",
    "webNavigation",
    "unlimitedStorage",
    "alarms"
  ],
  "optional_permissions": [
    "debugger"
  ],
  "host_permissions": ["<all_urls>", "ws://localhost/*", "ws://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["console-capture.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src 'self' ws://localhost:* ws://127.0.0.1:* wss://localhost:* wss://127.0.0.1:*;"
  },
  "action": {
    "default_title": "Browser Agent Bridge",
    "default_popup": "popup.html"
  }
}
